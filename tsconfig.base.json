{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",

    "types": ["node"],
    "moduleResolution": "nodenext",

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "esModuleInterop": true,

    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": true,

    "strict": true,

    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",

    "skipLibCheck": true
  }
}
